#!/usr/bin/env php
<?php

declare(strict_types=1);

use Stejac\Zeitangaben\Cli\Application;

$autoloaders = [
    $GLOBALS['_composer_autoload_path'] ?? null,
    __DIR__.'/../../../autoload.php',
    __DIR__.'/../vendor/autoload.php',
];

foreach ($autoloaders as $autoloader) {
    if (is_string($autoloader) && is_file($autoloader)) {
        require $autoloader;
        break;
    }
}

if (!class_exists(Application::class)) {
    fwrite(\STDERR, "zeitangaben: Composer autoloader not found. Run `composer install` first.\n");
    exit(2);
}

exit((new Application())->run($argv ?? ['zeitangaben'], \STDOUT, \STDERR));
